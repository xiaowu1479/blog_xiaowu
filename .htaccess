# Apache 部署时用：静态文件每次都回源校验（没变就是 304），
# 避免后台更新后浏览器还拿着旧的 HTML / CSS / JS。
# nginx 不读 .htaccess，nginx 的同类规则在 nginx.htaccess 里。
# 前面的 CDN 如果自己缓存了静态资源，仍然要在 CDN 后台刷新。
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>
